{
  "name": "acp-studio",
  "version": "0.1.0",
  "description": "ACP Studio — universal ACP agent workbench",
  "author": {
    "name": "yitom486",
    "email": "yitom486@gmail.com"
  },
  "type": "module",
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "studio.acp.app",
    "productName": "ACP Studio",
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/lib/**/*",
      "node_modules/node-pty/prebuilds/**/*",
      "node_modules/node-pty/build/Release/conpty/**/*",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/**/*.map",
      "!node_modules/node-pty/**/*.test.js"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "public/icon.png"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false
  },
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,green\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:desktop": "bun desktop/dev.ts",
    "clean": "bun scripts/clean-desktop.ts",
    "clean:desktop": "bun scripts/clean-desktop.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:server:node": "bun build server/node.ts --target=node --outdir=.tmp-node && node .tmp-node/node.js",
    "dev:client": "vite",
    "acp:stdio": "bunx @yitom/agy-acp-map@latest",
    "build": "tsc && vite build",
    "build:electron": "bun desktop/build.ts",
    "package:win": "bunx electron-builder --win nsis dir --publish never",
    "package:mac": "bunx electron-builder --mac dmg zip --publish never",
    "package:linux": "bunx electron-builder --linux AppImage deb --publish never",
    "start:electron": "electron electron-dist/main.cjs",
    "dev:electron": "ELECTRON_DEV=1 ELECTRON_START_URL=http://localhost:5188 electron electron-dist/main.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.8.0",
    "@assistant-ui/react": "^0.15.27",
    "@assistant-ui/react-markdown": "^0.14.20",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@shikijs/transformers": "^4.4.3",
    "@tanstack/react-query": "^5.103.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "hono": "^4.13.8",
    "lucide-react": "^0.475.0",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@yitom/acp-client": "0.1.2",
    "bun-types": "^1.4.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
