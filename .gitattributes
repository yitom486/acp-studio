# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure source code, plans, and config files always use LF (preventing AI edit tool failures on Windows CRLF)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Keep Windows-specific scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
